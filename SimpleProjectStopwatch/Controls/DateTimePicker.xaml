<UserControl x:Class="SimpleProjectStopwatch.Controls.DateTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimpleProjectStopwatch.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">

    <StackPanel>
        <DatePicker SelectedDate="{Binding DatePart, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="Stretch"/>

        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Hours, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding HourPart, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <TextBlock Grid.Column="1" Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" />

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Minutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding MinutePart, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />

            <TextBlock Grid.Column="3" Text=":" VerticalAlignment="Center" Margin="2,0" FontWeight="Bold" />

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding Seconds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      SelectedItem="{Binding SecondPart, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </StackPanel>
</UserControl>