<ui:ContentDialog x:Class="SimpleProjectStopwatch.Views.Dialogs.AETimeEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SimpleProjectStopwatch.Views.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:ui="http://schemas.modernwpf.com/2019"
                  xmlns:vm ="clr-namespace:SimpleProjectStopwatch.ViewModels"
                  d:DataContext="{d:DesignInstance Type=vm:AETimeEntryViewModel}"
                  xmlns:c="clr-namespace:SimpleProjectStopwatch.Controls"
                  
                  PrimaryButtonText="Speichern"
                  DefaultButton="Primary"
                  PrimaryButtonCommand="{Binding Save}">

    <Grid>
        <ui:ScrollViewerEx>
            <ui:SimpleStackPanel>
                <AccessText Text="Projekt:"/>
                <ComboBox ItemsSource="{Binding Projects}"
                      SelectedItem="{Binding TimeEntry.Project, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      HorizontalAlignment="Stretch"/>

                <AccessText Text="Startzeit:"/>
                <c:DateTimePicker Value="{Binding TimeEntry.StartTime, Mode=TwoWay}"/>

                <ui:HyperlinkButton Content="Jetzt" 
                                Command="{Binding SetTimeToNow}"
                                CommandParameter="0"/>

                <AccessText Text="Endzeit:"/>
                <c:DateTimePicker Value="{Binding TimeEntry.EndTime, Mode=TwoWay}"/>
                <ui:HyperlinkButton Content="Jetzt" 
                                Command="{Binding SetTimeToNow}"
                                CommandParameter="1"/>

                <AccessText Text="Beschreibung"/>
                <TextBox Text="{Binding TimeEntry.Description}"
                     AcceptsReturn="True"
                     Height="40"
                     HorizontalAlignment="Stretch"
                     TextWrapping="Wrap"/>


            </ui:SimpleStackPanel>
        </ui:ScrollViewerEx>
    </Grid>
</ui:ContentDialog>
